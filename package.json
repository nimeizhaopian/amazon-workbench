{
  "name": "amazon-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 DeepSeek Harness 的亚马逊运营工作台",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "dsh": "node --env-file-if-exists=.env scripts/start-dsh.mjs",
    "mcp:amazon": "node --env-file-if-exists=.env connectors/mcp-server.mjs",
    "test:mcp": "node tests/mcp-smoke.mjs",
    "format": "prettier --write \"web/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"plugins/**/*.mjs\" \"connectors/*.mjs\" \"scripts/*.mjs\" \"tests/*.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "http-proxy-middleware": "4.2.1",
    "js-yaml": "5.5.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
