# 本项目默认只监听本机；真实密钥只填写在复制后的 .env 中。
AW_PORT=4810
AW_DATA_DIR=.data
DSH_PORT=3088
DSH_ENABLED=true
DEEPSEEK_API_KEY=
# Amazon 私有 SP-API 应用的 LWA 凭据。未配置时只显示明确标记的演示店铺。
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE=US
# 紫鸟为可选社区 MCP。只有明确开启后才启动子进程。
ZINIAO_ENABLED=false
ZINIAO_MCP_COMMAND=uvx
ZINIAO_MCP_ARGS=["ziniao-mcp==0.1.33"]
ZINIAO_COMPANY=
ZINIAO_USERNAME=
ZINIAO_PASSWORD=
ZINIAO_CLIENT_PATH=
ZINIAO_VERSION=v6
